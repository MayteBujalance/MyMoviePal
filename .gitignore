Make sure your gitignore has all of these in it:

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
*.iml
*.sw?
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment
.env.local

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# IDEs

*.swp
*.swo
*~


# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# UV
.uv/